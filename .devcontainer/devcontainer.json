// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/almalinux
{
	"name": "liachra.github.io - Hugo DevContainer",
	"build": {
		"dockerfile": "Dockerfile"
	},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [1313],

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "echo '✓ Hugo version:' && hugo version && echo '' && echo '✓ Dev container ready!' && echo 'Start dev server with: hugo server -D'",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go",
				"eamodio.gitlens",
				"yzhang.markdown-all-in-one",
				"redhat.vscode-yaml"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"files.eol": "\n"
			}
		}
	},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
	// Use the non-root developer user provided by the Microsoft base image
	"remoteUser": "vscode"
}
